# Gradle
.gradle/
/build/

# Ghidra extension build outputs
/dist/
/bin/

# Ghidra project files created during manual import testing
*.gpr
*.rep/
*.lock

# Eclipse workspace/project metadata
.classpath
.project
.settings/
.metadata/
.factorypath
.apt_generated/
.apt_generated_tests/
.externalToolBuilders/
.recommenders/
*.launch

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# VS Code
.vscode/

# Java build products
*.class
*.war
*.ear
hs_err_pid*
replay_pid*

# Local dependency artifacts copied into the extension.
# Prefer declaring dependencies in build.gradle. Remove this rule if a vendored
# jar is intentionally part of the source distribution.
/lib/*.jar

# Logs and temporary files
*.log
*.tmp
*.temp
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Keep the Gradle wrapper checked in for reproducible builds.
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
